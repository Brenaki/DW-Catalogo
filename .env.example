# Conexão MySQL — usado quando roda a API localmente (npm start).
# No docker-compose esses valores vêm do próprio compose.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=catalogo
PORT=3000

# ── Deploy Swarm (stack-catalogo.yml) ─────────────────────────────────────
# Domínio roteado pelo Traefik.
APP_HOST=dw-catalogo.valc.cc

# Imagem que você builda e dá push (docker build -t $CATALOGO_APP_IMAGE .)
CATALOGO_APP_IMAGE=registry.example.com/catalogo-app:latest

# Senha do root do MySQL (usada pela app e pelo container do banco).
MYSQL_ROOT_PASSWORD=change-me
